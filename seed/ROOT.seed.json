      "path": "c/host/wasm/"
    },
    {
      "id": "mcu",
      "kind": "mcu",
      "path": "c/host/mcu/"
    },
    {
      "id": "python-host",
      "kind": "posix",
      "path": "unified/machine/host.py"
    }
  ],
