  "gaps": [
    {
      "id": "gap.seed-expresses-full-framework",
      "paths": [
        "unified/",
        "tests/",
        "scripts/"
      ],
      "rule": "3",
      "status": "open",
      "summary": "UEM machine, generator, and framework modules are not yet fully expressed as seed package bodies; currently handwritten under unified/."
    },
    {
      "id": "gap.no-app-control-flow-in-host",
      "paths": [
        "unified/machine/",
        "c/core/",
        "c/host/"
      ],
      "rule": "6",
      "status": "open",
      "summary": "Python/C UEM hosts still use imperative control flow (required for physical boundary execution until seed can emit hosts)."
    },
    {
      "id": "gap.oop-exprfail",
      "paths": [
        "unified/machine/primitives.py"
      ],
      "rule": "5",
      "status": "closed",
      "summary": "Closed: _ExprFail class removed; expression faults are plain Exception marker tuples (no ClassDef)."
    },
    {
      "id": "gap.declarations-as-python",
      "paths": [
        "examples/declarations/"
      ],
      "rule": "4",
      "status": "open",
      "summary": "Application declarations live as .py modules with Python syntax; must be pure JSON under seed/declarations/."
    },
    {
      "id": "gap.dual-host-not-single-machine-surface",
      "paths": [
        "unified/machine/",
        "c/core/"
      ],
      "rule": "7",
      "status": "design-ticket",
      "summary": "Python and C interpreters are parallel implementations; Standard Ten requires one UEM with hosts as boundaries only. Semantic parity is proven (L11) but structure is dual-impl."
    },
    {
      "id": "gap.generated-tests-and-docs",
      "paths": [
        "tests/",
        "docs/",
        "LAW.md",
        "SPEC.md",
        "README.md"
      ],
      "rule": "10",
      "status": "open",
      "summary": "Tests and documentation are handwritten, not generated from seed/declaration."
    },
    {
      "id": "gap.clean-room-full-tree",
      "paths": [
        "."
      ],
      "rule": "3",
      "status": "open",
      "summary": "Clean-room regeneration cannot yet emit the full repository from seed alone."
    }
  ],
