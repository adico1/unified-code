{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uc://schemas/economics/retrospective@1",
  "title": "Unified Code privacy-preserving economic retrospective",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "extractor_version",
    "status",
    "cutoff",
    "sources",
    "privacy",
    "measurement_boundary",
    "allowed_claim",
    "prohibited_claims",
    "dataset_sha256"
  ],
  "properties": {
    "format": {"const": "uc-economic-retrospective-1"},
    "extractor_version": {"const": "UC-ECONOMIC-RETROSPECTIVE-1"},
    "status": {"const": "retrospective-observational"},
    "cutoff": {"type": "string", "format": "date-time"},
    "sources": {"type": "object"},
    "privacy": {"type": "object"},
    "measurement_boundary": {"type": "object"},
    "allowed_claim": {"type": "string", "minLength": 1},
    "prohibited_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
