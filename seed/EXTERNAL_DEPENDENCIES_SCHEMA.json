{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uc://schemas/external-dependencies@1",
  "title": "Unified Code external dependency provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "canonicalization",
    "vendored_roots",
    "dependencies",
    "substrate_requirements",
    "excluded_external_surfaces"
  ],
  "properties": {
    "format_version": {"const": "UC-EXTERNAL-DEPENDENCIES-1"},
    "canonicalization": {"const": "UC-CANONICAL-JSON-1"},
    "vendored_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "substrate_requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/substrate"}
    },
    "excluded_external_surfaces": {
      "type": "array",
      "items": {"$ref": "#/$defs/exclusion"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "size", "immutable_source", "root_reference"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0},
        "immutable_source": {"type": "string", "minLength": 1},
        "root_reference": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "license"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "license": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "canonical_name", "kind", "role", "version", "upstream",
        "artifacts", "license", "acquisition", "verification",
        "reproducibility", "offline_bootstrap", "maintenance",
        "replacement_plan", "dependents"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "canonical_name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["external-vendored", "project-originated"]},
        "role": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "immutable_revision"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "immutable_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "artifacts": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "files", "note"],
          "properties": {
            "spdx": {"type": "string", "minLength": 1},
            "files": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {"$ref": "#/$defs/sha256"}
                }
              }
            },
            "note": {"type": "string", "minLength": 1}
          }
        },
        "acquisition": {"$ref": "#/$defs/procedure"},
        "verification": {"$ref": "#/$defs/procedure"},
        "reproducibility": {"$ref": "#/$defs/procedure"},
        "offline_bootstrap": {"$ref": "#/$defs/procedure"},
        "maintenance": {
          "type": "object", "additionalProperties": false,
          "required": ["update_cadence", "security_owner"],
          "properties": {
            "update_cadence": {"type": "string", "minLength": 1},
            "security_owner": {"type": "string", "minLength": 1}
          }
        },
        "replacement_plan": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "plan"],
          "properties": {
            "status": {"type": "string", "minLength": 1},
            "plan": {"type": "string", "minLength": 1}
          }
        },
        "dependents": {
          "type": "object", "additionalProperties": false,
          "required": ["stage0", "stage1"],
          "properties": {
            "stage0": {"type": "array", "items": {"type": "string"}},
            "stage1": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "procedure": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "procedure"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "procedure": {"type": "string", "minLength": 1}
      }
    },
    "substrate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "constraint", "boundary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "constraint": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "exclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["surface", "reason"],
      "properties": {
        "surface": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
