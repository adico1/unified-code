{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uc-stage0-generation-manifest-schema-1",
  "title": "Unified Code Stage-0 Generation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "stage0_version",
    "contract_sha256",
    "input_inventory",
    "output_inventory",
    "stage1_payload_tree_sha256",
    "evidence",
    "verification_result"
  ],
  "properties": {
    "format_version": { "const": "UC-STAGE0-GENERATION-MANIFEST-1" },
    "stage0_version": { "const": "UC-STAGE0-1" },
    "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input_inventory": { "type": "array", "minItems": 6, "maxItems": 6 },
    "output_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "const": "stage1-handoff.json" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "stage1_payload_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "const": [
        "boundary:contract:read",
        "stage0:contract-verified",
        "boundary:trusted-inputs:read",
        "stage0:inputs-verified",
        "stage0:handoff-planned"
      ]
    },
    "verification_result": { "const": "valid" }
  }
}
