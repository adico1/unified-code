{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uc-application-v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["application_version", "application", "interface", "program", "boundaries", "persistence", "formats", "ui", "acceptance"],
  "properties": {
    "application_version": {"const": "UC-APPLICATION-3"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "package", "description", "canonical_name", "family", "build_group", "variation", "notation", "numeric_type", "interface_identity", "capabilities", "dependency_contract_ref"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "package": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "description": {"type": "string"},
        "canonical_name": {"type": "string", "pattern": "^uc://applications/[a-z][a-z0-9-]*@[1-9][0-9]*$"},
        "family": {"type": "string", "minLength": 1},
        "build_group": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "variation": {"type": "string", "minLength": 1},
        "notation": {"type": "string", "minLength": 1},
        "numeric_type": {"type": "string", "minLength": 1},
        "numeric_contract": {"type": "string", "minLength": 1},
        "interface_identity": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dependency_contract_ref": {"type": "string", "minLength": 1}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "library", "browser"],
      "properties": {"cli": {"type": "boolean"}, "library": {"type": "boolean"}, "browser": {"type": "boolean"}}
    },
    "program": {
      "type": "object",
      "required": ["engine", "operations"],
      "properties": {
        "engine": {"enum": ["document", "numeric", "expression", "world"]},
        "operations": {"type": "object", "minProperties": 1}
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["acceptance_deadline_seconds"],
      "properties": {
        "acceptance_deadline_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "persistence": {"type": "object"},
    "formats": {"type": "object"},
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "interface"],
      "properties": {"application": {"type": "string"}, "interface": {"const": "library"}}
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "theme", "layout", "actions", "bindings", "keyboard", "responsive", "proof"],
      "properties": {
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "description", "requires_root"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1},
            "requires_root": {"type": "boolean"}
          }
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["background", "surface", "text", "muted", "primary", "danger"],
          "properties": {
            "background": {"type": "string"},
            "surface": {"type": "string"},
            "text": {"type": "string"},
            "muted": {"type": "string"},
            "primary": {"type": "string"},
            "danger": {"type": "string"}
          }
        },
        "layout": {
          "type": "object",
          "required": ["sections"],
          "properties": {
            "sections": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "title", "components"],
                "properties": {
                  "id": {"type": "string"},
                  "title": {"type": "string"},
                  "wide": {"type": "boolean"},
                  "class": {"type": "string"},
                  "components": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["id", "type", "label"],
                      "properties": {
                        "id": {"type": "string"},
                        "type": {"enum": ["button", "canvas", "file_path", "label", "list", "number", "output", "select", "status", "table", "text", "textarea"]},
                        "label": {"type": "string"},
                        "accessible_name": {"type": "string"},
                        "action": {"type": "string"},
                        "options": {"type": "array"},
                        "width": {"type": "integer"},
                        "height": {"type": "integer"}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "actions": {"type": "object", "minProperties": 1},
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "error", "status", "root"],
          "properties": {
            "result": {"type": "array"},
            "error": {"type": "object"},
            "status": {"type": "object"},
            "root": {"type": "object"},
            "canvas": {"type": ["object", "null"]}
          }
        },
        "keyboard": {"type": "array"},
        "automation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "interval_ms", "while"],
          "properties": {
            "action": {"type": "string"},
            "interval_ms": {"type": "integer", "minimum": 1},
            "while": {"type": "string"}
          }
        },
        "responsive": {
          "type": "object",
          "required": ["breakpoint_px"],
          "properties": {"breakpoint_px": {"type": "integer", "minimum": 1}}
        },
        "proof": {
          "type": "object",
          "required": ["fixtures", "steps", "expected_error"],
          "properties": {
            "fixtures": {"type": "array"},
            "steps": {"type": "array", "minItems": 3},
            "expected_error": {"type": "string"}
          }
        }
      }
    },
    "acceptance": {"type": "array", "minItems": 1}
  }
}
