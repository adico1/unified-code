{
  "format_version": "UC-VERIFY-FLOW-2",
  "budget_seconds": 5.0,
  "scheduler": "parallel-release",
  "release_policy": "dependency",
  "cache_policy": "content-addressed-verified",
  "failure_policy": "propagate",
  "timeout_policy": "fail",
  "terminal_event": "verification.completed",
  "failure_events": [
    "proof.failed",
    "timeout.reached",
    "identity.stale",
    "worker.missing",
    "evidence.incomplete",
    "budget.exceeded",
    "cache.corrupt",
    "cache.partial",
    "cache.wrong-platform",
    "timing-boundary.invalid"
  ],
  "routes": {
    "verification.requested": "tools.boot.request",
    "tools.boot.requested": "tools.boot.complete",
    "tools.boot.completed": "verification.clock.start",
    "verification.clock.started": "authority.resolve",
    "authorities.resolved": "proof_graph.release",
    "proof_graph.released": "proof.complete",
    "proof.completed": "evidence.complete",
    "evidence.completed": "verification.clock.stop",
    "verification.clock.stopped": "budget.measure",
    "budget.measured": "verification.complete",
    "verification.completed": "terminal"
  },
  "events": [
    "verification.requested",
    "tools.boot.requested",
    "tools.boot.completed",
    "verification.clock.started",
    "authorities.resolved",
    "proof_graph.released",
    "proof.completed",
    "evidence.completed",
    "verification.clock.stopped",
    "budget.measured",
    "verification.completed"
  ],
  "bootload_activities": [
    "python-entry",
    "argv-parse",
    "monotonic-clock"
  ],
  "verification_activities": [
    "repository-discovery",
    "source-hashing",
    "authority-resolution",
    "proof-graph-construction",
    "python-c-compilation",
    "fixture-generation",
    "application-generation",
    "browser-preparation",
    "test-collection",
    "test-execution",
    "coverage",
    "mutations",
    "fuzzing",
    "sanitizers",
    "native-goldens",
    "fixed-point-generation",
    "proof-artifact-creation",
    "cache-lookup",
    "cache-identity-validation",
    "cache-miss-handling",
    "evidence-aggregation",
    "verdict-formation"
  ],
  "bundle_path": "seed/verification/PROOF_BUNDLE.json",
  "evidence_nodes": [
    {
      "id": "repository-tests",
      "handler": "command",
      "requires": [],
      "argv": ["{python}", "-m", "unified.selftest", "--profile", "complete"]
    },
  {
    "id": "l13-gauntlet",
    "handler": "command",
    "requires": ["repository-tests"],
      "argv": ["{python}", "scripts/verify_l13_evidence.py"]
    },
  {
    "id": "standard-audit",
    "handler": "command",
    "requires": ["repository-tests"],
      "argv": ["{python}", "scripts/audit_standard_ten.py", "audit"]
    },
  {
    "id": "clean-room",
    "handler": "command",
    "requires": ["repository-tests"],
      "argv": ["bash", "scripts/clean_room_ten.sh"]
    },
  {
    "id": "uem-gauntlet",
    "handler": "command",
    "requires": ["repository-tests"],
      "argv": ["{python}", "-m", "unified.generator.cli", "gauntlet", "examples/declarations/text_stats_v2.json"]
    },
  {
    "id": "issue7-generated-surface",
    "handler": "command",
    "requires": ["repository-tests"],
      "argv": ["{python}", "generated/verification_surface/audit/run_audit.py"]
    }
  ],
  "proof_nodes": [
    {"id": "repository-tests", "requires": ["repository-tests"]},
    {"id": "stage0-contract", "requires": ["repository-tests"]},
    {"id": "stage1-generation", "requires": ["repository-tests"]},
    {"id": "stage1-fixed-point", "requires": ["repository-tests"]},
    {"id": "standard-ten", "requires": ["repository-tests", "standard-audit", "clean-room"]},
    {"id": "l1-l13", "requires": ["repository-tests", "l13-gauntlet", "uem-gauntlet"]},
    {"id": "python-c-equivalence", "requires": ["repository-tests", "l13-gauntlet"]},
    {"id": "python-c-coverage", "requires": ["repository-tests", "l13-gauntlet"]},
    {"id": "mutations", "requires": ["repository-tests"]},
    {"id": "deterministic-fuzzing", "requires": ["repository-tests"]},
    {"id": "sanitizers", "requires": ["repository-tests"]},
    {"id": "native-goldens", "requires": ["repository-tests"]},
    {"id": "application-assembly", "requires": ["repository-tests"]},
    {"id": "manifestation-direct-identity", "requires": ["repository-tests"]},
    {"id": "cli-gui-equality", "requires": ["repository-tests"]},
    {"id": "real-browser", "requires": ["repository-tests"]},
    {"id": "atomic-preservation", "requires": ["repository-tests"]},
    {"id": "isolated-runtime", "requires": ["repository-tests"]},
    {"id": "provenance", "requires": ["repository-tests", "standard-audit"]},
    {"id": "open-gap-truthfulness", "requires": ["repository-tests", "standard-audit"]},
    {"id": "python-3.11", "requires": ["repository-tests"]},
    {"id": "python-3.12", "requires": ["repository-tests"]},
    {"id": "python-3.13", "requires": ["repository-tests"]},
    {"id": "issue7-generated-surface", "requires": ["issue7-generated-surface"]}
  ]
}
