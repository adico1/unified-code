{
  "$id": "https://github.com/adico1/unified-code/blob/main/seed/MANIFESTATION_SCHEMA.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compiler_version": {
      "const": "THING-V2-1"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/record"
      },
      "minItems": 1,
      "type": "array"
    },
    "registry_snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "registry_version": {
      "const": 1
    }
  },
  "required": [
    "registry_version",
    "compiler_version",
    "registry_snapshot_sha256",
    "records"
  ],
  "title": "Unified Code name-to-manifestation registry",
  "type": "object",
  "$defs": {
    "record": {
      "additionalProperties": false,
      "properties": {
        "artifact_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_name": {
          "pattern": "^uc://applications/[a-z][a-z0-9-]*@[1-9][0-9]*$",
          "type": "string"
        },
        "compiler_version": {
          "const": "THING-V2-1"
        },
        "seed_id": {
          "minLength": 1,
          "type": "string"
        },
        "seed_ref": {
          "minLength": 1,
          "type": "string"
        },
        "seed_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "canonical_name",
        "seed_id",
        "seed_ref",
        "seed_sha256",
        "compiler_version",
        "artifact_tree_sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
