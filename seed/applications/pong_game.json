{
  "application_version": "UC-APPLICATION-3",
  "application": {"name": "pong-game", "package": "pong_game", "description": "Deterministic event-driven graphical world replay."},
  "interface": {"cli": true, "library": false, "browser": true},
  "program": {
    "engine": "world",
    "operations": {"transition": {"primitive": "world_advance"}},
    "window": {"width": 800, "height": 480},
    "field": {"width": 100, "height": 60},
    "horizontal_roles": ["left", "right"],
    "controls": {
      "Space": {"event": "start"},
      "KeyP": {"event": "pause"},
      "KeyR": {"event": "reset"},
      "ArrowUp": {"event": "tick", "ticks": 1, "inputs": [{"actor": "right", "delta": -4}]},
      "ArrowDown": {"event": "tick", "ticks": 1, "inputs": [{"actor": "right", "delta": 4}]},
      "KeyW": {"event": "tick", "ticks": 1, "inputs": [{"actor": "left", "delta": -5}]},
      "KeyS": {"event": "tick", "ticks": 1, "inputs": [{"actor": "left", "delta": 4}]}
    },
    "browser_proof": {
      "control_codes": ["Space", "KeyW", "KeyP"],
      "expected_scenario": "deterministic-replay",
      "expected_step": 2,
      "minimum_distinct_frames": 2
    },
    "presentation": {"background": "#05080f", "foreground": "#ffffff"},
    "events": {"start": "start", "pause": "pause", "resume": "resume", "advance": "tick", "point": "score", "reset": "reset", "stop": "stop"},
    "state_file": "world-state.json",
    "initial_state": {
      "active": false,
      "tick": 0,
      "actors": {
        "left": {"x": 2, "y": 20, "width": 4, "height": 20},
        "right": {"x": 94, "y": 0, "width": 4, "height": 2}
      },
      "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
      "counters": {"left": 0, "right": 0}
    }
  },
  "boundaries": {"clock": "tick", "input": "event", "presentation": ["headless", "browser"], "persistence": "OUTWARD", "acceptance_deadline_seconds": 10},
  "persistence": {"mode": "atomic-json", "identity": "world-state.json"},
  "formats": {"outer_input": "event-object", "outer_output": "frame-state"},
  "ui": {
    "page": {
      "id": "arcade-court",
      "title": "Pong",
      "description": "A deterministic two-player match driven by declared events and ticks.",
      "requires_root": false
    },
    "theme": {"background": "#04070d", "surface": "#101a2b", "text": "#ffffff", "muted": "#9fb4ce", "primary": "#5df2c1", "danger": "#ff7b91"},
    "layout": {
      "sections": [
        {
          "id": "arcade-controls",
          "title": "Match controls",
          "components": [
            {"id": "arcade-root", "type": "label", "label": "Runtime root", "accessible_name": "Runtime root"},
            {"id": "arcade-start", "type": "button", "label": "Start", "accessible_name": "Start match", "action": "start-match", "primary": true},
            {"id": "arcade-pause", "type": "button", "label": "Pause", "accessible_name": "Pause match", "action": "pause-match"},
            {"id": "arcade-resume", "type": "button", "label": "Resume", "accessible_name": "Resume match", "action": "resume-match"},
            {"id": "arcade-reset", "type": "button", "label": "Reset", "accessible_name": "Reset match", "action": "reset-match"},
            {"id": "arcade-left-up", "type": "button", "label": "Left up (W)", "accessible_name": "Move left paddle up", "action": "left-up"},
            {"id": "arcade-left-down", "type": "button", "label": "Left down (S)", "accessible_name": "Move left paddle down", "action": "left-down"},
            {"id": "arcade-right-up", "type": "button", "label": "Right up (↑)", "accessible_name": "Move right paddle up", "action": "right-up"},
            {"id": "arcade-right-down", "type": "button", "label": "Right down (↓)", "accessible_name": "Move right paddle down", "action": "right-down"},
            {"id": "arcade-instructions", "type": "label", "label": "Keyboard controls", "accessible_name": "Keyboard control instructions", "value": "W/S moves the left paddle; arrow keys move the right paddle; Space starts; P pauses; R resets."},
            {"id": "arcade-score", "type": "output", "label": "Score", "accessible_name": "Match score"},
            {"id": "arcade-status", "type": "status", "label": "Status", "accessible_name": "Match status"},
            {"id": "arcade-error", "type": "output", "label": "Error", "accessible_name": "Match error"}
          ]
        },
        {
          "id": "arcade-screen",
          "title": "Playing field",
          "wide": true,
          "components": [
            {"id": "arcade-canvas", "type": "canvas", "label": "Pong playing field", "accessible_name": "Pong playing field", "width": 800, "height": 480}
          ]
        }
      ]
    },
    "actions": {
      "start-match": {"mode": "request", "request": {"event": "start"}},
      "pause-match": {"mode": "request", "request": {"event": "pause"}},
      "resume-match": {"mode": "request", "request": {"event": "resume"}},
      "reset-match": {"mode": "request", "request": {"event": "reset"}},
      "advance-frame": {"mode": "request", "request": {"event": "tick", "ticks": 1}},
      "left-up": {"mode": "request", "request": {"event": "tick", "ticks": 1, "inputs": [{"actor": "left", "delta": -5}]}},
      "left-down": {"mode": "request", "request": {"event": "tick", "ticks": 1, "inputs": [{"actor": "left", "delta": 4}]}},
      "right-up": {"mode": "request", "request": {"event": "tick", "ticks": 1, "inputs": [{"actor": "right", "delta": -4}]}},
      "right-down": {"mode": "request", "request": {"event": "tick", "ticks": 1, "inputs": [{"actor": "right", "delta": 4}]}}
    },
    "bindings": {
      "result": [
        {"source": "output.counters", "target": "arcade-score", "property": "text"}
      ],
      "error": {"target": "arcade-error", "property": "text"},
      "status": {"target": "arcade-status", "property": "text", "success": "Frame accepted", "failure": "Frame rejected"},
      "root": {"target": "arcade-root", "property": "text"},
      "canvas": {
        "target": "arcade-canvas",
        "background": "#05080f",
        "scale_x": 8,
        "scale_y": 8,
        "shapes": [
          {"collection": "actors", "x": "x", "y": "y", "width": "width", "height": "height", "color": "#ffffff"},
          {"path": "mover", "x": "x", "y": "y", "width": "size", "height": "size", "color": "#5df2c1"}
        ],
        "text": [{"path": "counters", "join": " : ", "x": 380, "y": 24, "color": "#ffffff"}]
      }
    },
    "keyboard": [
      {"key": " ", "action": "start-match"},
      {"key": "p", "action": "pause-match"},
      {"key": "r", "action": "reset-match"},
      {"key": "w", "action": "left-up"},
      {"key": "s", "action": "left-down"},
      {"key": "ArrowUp", "action": "right-up"},
      {"key": "ArrowDown", "action": "right-down"}
    ],
    "responsive": {"breakpoint_px": 820},
    "automation": {"action": "advance-frame", "interval_ms": 32, "while": "output.active"},
    "proof": {
      "fixtures": [],
      "steps": [
        {"control": "arcade-start", "expect": {"target": "arcade-status", "equals": "Frame accepted"}},
        {"keyboard": "w", "expect": {"target": "arcade-score", "equals": "left"}},
        {"keyboard": "ArrowDown", "expect": {"target": "arcade-status", "equals": "Frame accepted"}},
        {"control": "arcade-pause", "expect": {"target": "arcade-status", "equals": "Frame accepted"}},
        {"control": "arcade-reset", "expect": {"target": "arcade-score", "equals": "left"}}
      ],
      "expected_error": ""
    }
  },
  "acceptance": [
    {
      "id": "deterministic-replay",
      "fixtures": [],
      "steps": [
        {
          "request": {"event": "start"},
          "expect": {
            "state": "valid",
            "output": {
              "active": true, "tick": 0,
              "actors": {"left": {"x": 2, "y": 20, "width": 4, "height": 20}, "right": {"x": 94, "y": 0, "width": 4, "height": 2}},
              "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
              "counters": {"left": 0, "right": 0}
            },
            "error": null,
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing", "stage:05_core_collect", "stage:06_core_to_inner", "stage:07_inner_to_outer", "boundary:outward"]
          }
        },
        {
          "request": {"event": "tick", "ticks": 1, "inputs": [{"actor": "left", "delta": -5}]},
          "expect": {
            "state": "valid",
            "output": {
              "active": true, "tick": 1,
              "actors": {"left": {"x": 2, "y": 15, "width": 4, "height": 20}, "right": {"x": 94, "y": 0, "width": 4, "height": 2}},
              "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
              "counters": {"left": 1, "right": 0},
              "events": ["score"],
              "trace": [{
                "active": true, "tick": 1,
                "actors": {"left": {"x": 2, "y": 15, "width": 4, "height": 20}, "right": {"x": 94, "y": 0, "width": 4, "height": 2}},
                "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
                "counters": {"left": 1, "right": 0},
                "events": ["score"]
              }]
            },
            "error": null,
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing", "stage:05_core_collect", "stage:06_core_to_inner", "stage:07_inner_to_outer", "boundary:outward"]
          }
        },
        {
          "request": {"event": "pause"},
          "expect": {
            "state": "valid",
            "output": {
              "active": false, "tick": 1,
              "actors": {"left": {"x": 2, "y": 15, "width": 4, "height": 20}, "right": {"x": 94, "y": 0, "width": 4, "height": 2}},
              "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
              "counters": {"left": 1, "right": 0},
              "events": ["score"],
              "trace": [{
                "active": true, "tick": 1,
                "actors": {"left": {"x": 2, "y": 15, "width": 4, "height": 20}, "right": {"x": 94, "y": 0, "width": 4, "height": 2}},
                "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
                "counters": {"left": 1, "right": 0},
                "events": ["score"]
              }]
            },
            "error": null,
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing", "stage:05_core_collect", "stage:06_core_to_inner", "stage:07_inner_to_outer", "boundary:outward"]
          }
        },
        {
          "request": {"event": "resume"},
          "expect": {
            "state": "valid",
            "output": {
              "active": true, "tick": 1,
              "actors": {"left": {"x": 2, "y": 15, "width": 4, "height": 20}, "right": {"x": 94, "y": 0, "width": 4, "height": 2}},
              "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
              "counters": {"left": 1, "right": 0},
              "events": ["score"],
              "trace": [{
                "active": true, "tick": 1,
                "actors": {"left": {"x": 2, "y": 15, "width": 4, "height": 20}, "right": {"x": 94, "y": 0, "width": 4, "height": 2}},
                "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
                "counters": {"left": 1, "right": 0},
                "events": ["score"]
              }]
            },
            "error": null,
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing", "stage:05_core_collect", "stage:06_core_to_inner", "stage:07_inner_to_outer", "boundary:outward"]
          }
        },
        {
          "request": {"event": "stop"},
          "expect": {
            "state": "valid",
            "output": {
              "active": false, "tick": 1,
              "actors": {"left": {"x": 2, "y": 15, "width": 4, "height": 20}, "right": {"x": 94, "y": 0, "width": 4, "height": 2}},
              "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
              "counters": {"left": 1, "right": 0},
              "events": ["score"],
              "trace": [{
                "active": true, "tick": 1,
                "actors": {"left": {"x": 2, "y": 15, "width": 4, "height": 20}, "right": {"x": 94, "y": 0, "width": 4, "height": 2}},
                "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
                "counters": {"left": 1, "right": 0},
                "events": ["score"]
              }]
            },
            "error": null,
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing", "stage:05_core_collect", "stage:06_core_to_inner", "stage:07_inner_to_outer", "boundary:outward"]
          }
        },
        {
          "request": {"event": "reset"},
          "expect": {
            "state": "valid",
            "output": {
              "active": false, "tick": 0,
              "actors": {"left": {"x": 2, "y": 20, "width": 4, "height": 20}, "right": {"x": 94, "y": 0, "width": 4, "height": 2}},
              "mover": {"x": 98, "y": 30, "vx": 3, "vy": 2, "size": 2},
              "counters": {"left": 0, "right": 0}
            },
            "error": null,
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing", "stage:05_core_collect", "stage:06_core_to_inner", "stage:07_inner_to_outer", "boundary:outward"]
          }
        }
      ]
    }
  ]
}
