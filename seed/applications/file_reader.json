{
  "application_version": "UC-APPLICATION-3",
  "application": {"name": "file-reader", "package": "file_reader", "description": "Read declared text resources through an OUTWARD boundary."},
  "interface": {"cli": true, "library": false, "browser": true},
  "program": {
    "engine": "document",
    "operations": {"read": {"primitive": "bytes_load"}},
    "encoding": "utf-8"
  },
  "boundaries": {"filesystem": "OUTWARD", "authority": "runtime-root", "acceptance_deadline_seconds": 10},
  "persistence": {"mode": "none"},
  "formats": {"outer_input": "json-object", "outer_output": "json-object"},
  "ui": {
    "page": {
      "id": "reader-workbench",
      "title": "File Reader",
      "description": "Read a text file inside the authorized root and verify its metadata.",
      "requires_root": true
    },
    "theme": {"background": "#08111f", "surface": "#10243b", "text": "#f2f7ff", "muted": "#a9bdd2", "primary": "#62d6c8", "danger": "#ff8f8f"},
    "layout": {
      "sections": [
        {
          "id": "reader-input",
          "title": "Authorized file",
          "components": [
            {"id": "reader-root", "type": "label", "label": "Authorized root", "accessible_name": "Authorized root"},
            {"id": "reader-path", "type": "file_path", "label": "Relative file path", "accessible_name": "File path", "placeholder": "message.txt"},
            {"id": "reader-read", "type": "button", "label": "Read", "accessible_name": "Read file", "action": "read-resource", "primary": true},
            {"id": "reader-status", "type": "status", "label": "Status", "accessible_name": "Read status"},
            {"id": "reader-error", "type": "output", "label": "Error", "accessible_name": "Read error"}
          ]
        },
        {
          "id": "reader-result",
          "title": "Content and identity",
          "wide": true,
          "components": [
            {"id": "reader-content", "type": "textarea", "label": "Content", "accessible_name": "File content", "readonly": true},
            {"id": "reader-encoding", "type": "output", "label": "Encoding", "accessible_name": "File encoding"},
            {"id": "reader-size", "type": "output", "label": "File size", "accessible_name": "File size"},
            {"id": "reader-hash", "type": "output", "label": "SHA-256", "accessible_name": "File SHA-256"},
            {"id": "reader-empty", "type": "output", "label": "Empty file", "accessible_name": "Empty file state"}
          ]
        }
      ]
    },
    "actions": {
      "read-resource": {"mode": "request", "request": {"action": "read", "path": {"$control": "reader-path"}}}
    },
    "bindings": {
      "result": [
        {"source": "output.content", "target": "reader-content", "property": "value"},
        {"source": "output.encoding", "target": "reader-encoding", "property": "text"},
        {"source": "output.size", "target": "reader-size", "property": "text"},
        {"source": "output.sha256", "target": "reader-hash", "property": "text"},
        {"source": "output.empty", "target": "reader-empty", "property": "text"}
      ],
      "error": {"target": "reader-error", "property": "text"},
      "status": {"target": "reader-status", "property": "text", "success": "Read complete", "failure": "Read failed"},
      "root": {"target": "reader-root", "property": "text"}
    },
    "keyboard": [{"key": "Enter", "action": "read-resource"}],
    "responsive": {"breakpoint_px": 760},
    "proof": {
      "fixtures": [{"path": "message.txt", "text": "hello\n"}],
      "steps": [
        {"set": {"reader-path": "message.txt"}, "control": "reader-read", "expect": {"target": "reader-content", "equals": "hello"}},
        {"set": {"reader-path": "empty.txt"}, "control": "reader-read", "expect": {"target": "reader-error", "equals": "resource-missing"}},
        {"set": {"reader-path": "message.txt"}, "keyboard": "Enter", "expect": {"target": "reader-hash", "equals": "5891b5b5"}}
      ],
      "expected_error": "resource-missing"
    }
  },
  "acceptance": [
    {
      "id": "content",
      "fixtures": [{"path": "message.txt", "text": "hello\n"}],
      "steps": [
        {
          "request": {"action": "read", "path": "message.txt"},
          "expect": {
            "state": "valid",
            "output": {"content": "hello\n", "empty": false, "encoding": "utf-8", "sha256": "5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03", "size": 6},
            "error": null,
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing", "stage:05_core_collect", "stage:06_core_to_inner", "stage:07_inner_to_outer", "boundary:outward"]
          }
        }
      ]
    },
    {
      "id": "empty",
      "fixtures": [{"path": "empty.txt", "text": ""}],
      "steps": [
        {
          "request": {"action": "read", "path": "empty.txt"},
          "expect": {
            "state": "valid",
            "output": {"content": "", "empty": true, "encoding": "utf-8", "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "size": 0},
            "error": null,
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing", "stage:05_core_collect", "stage:06_core_to_inner", "stage:07_inner_to_outer", "boundary:outward"]
          }
        }
      ]
    },
    {
      "id": "missing",
      "fixtures": [],
      "steps": [
        {
          "request": {"action": "read", "path": "missing.txt"},
          "expect": {
            "state": "invalid", "output": null, "error": "resource-missing",
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing:error", "boundary:outward"]
          }
        }
      ]
    },
    {
      "id": "invalid-and-unavailable",
      "fixtures": [{"path": "invalid.txt", "hex": "ff"}, {"path": "folder", "directory": true}],
      "steps": [
        {
          "request": {"action": "read", "path": "invalid.txt"},
          "expect": {
            "state": "invalid", "output": null, "error": "invalid-encoding",
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing:error", "boundary:outward"]
          }
        },
        {
          "request": {"action": "read", "path": "folder"},
          "expect": {
            "state": "invalid", "output": null, "error": "resource-unavailable",
            "evidence": ["boundary:inward", "stage:01_outer_to_inner", "stage:02_inner_to_core", "stage:03_core_prepare", "stage:04_core_processing:error", "boundary:outward"]
          }
        }
      ]
    }
  ]
}
