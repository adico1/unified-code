{
  "boundaries": [
    {
      "kind": "state_read",
      "name": "load_state",
      "phase": "OUTWARD"
    },
    {
      "kind": "state_write",
      "name": "persist_state",
      "phase": "OUTWARD"
    }
  ],
  "cli": {
    "script": "uc-task-ledger"
  },
  "composition": [
    "inward",
    "parse_host_argv",
    "load_state",
    "apply_command",
    "persist_state",
    "verify",
    "present_result",
    "outward"
  ],
  "description": "A deterministic, event-routed, persistent task ledger generated entirely from one JSON seed.",
  "features": [
    {
      "boundaries": [],
      "doc": "Apply one declared command to the loaded resource state without performing I/O.",
      "errors": [
        "invalid-title",
        "duplicate-title",
        "task-not-open",
        "unknown-command"
      ],
      "invariants": [
        "task order is insertion order",
        "completion preserves task order",
        "validation failure does not change state"
      ],
      "name": "apply_command",
      "role": "transform",
      "tests": [],
      "transformation": {
        "acceptance": [
          {
            "argv": ["add", "A"],
            "expect": {
              "added": "A",
              "completed": false
            }
          },
          {
            "argv": ["add", "B"],
            "expect": {
              "added": "B",
              "completed": false
            }
          },
          {
            "argv": ["list"],
            "expect": {
              "tasks": [
                {
                  "completed": false,
                  "title": "A"
                },
                {
                  "completed": false,
                  "title": "B"
                }
              ]
            }
          },
          {
            "argv": ["add", "A"],
            "exit": 1,
            "expect": {
              "error": "duplicate-title",
              "state": "invalid"
            }
          },
          {
            "argv": ["list"],
            "expect": {
              "tasks": [
                {
                  "completed": false,
                  "title": "A"
                },
                {
                  "completed": false,
                  "title": "B"
                }
              ]
            }
          },
          {
            "argv": ["complete", "A"],
            "expect": {
              "completed": "A"
            }
          },
          {
            "argv": ["complete", "A"],
            "exit": 1,
            "expect": {
              "error": "task-not-open",
              "state": "invalid"
            }
          },
          {
            "argv": ["list"],
            "expect": {
              "tasks": [
                {
                  "completed": true,
                  "title": "A"
                },
                {
                  "completed": false,
                  "title": "B"
                }
              ]
            }
          },
          {
            "argv": ["list"],
            "expect": {
              "tasks": [
                {
                  "completed": true,
                  "title": "A"
                },
                {
                  "completed": false,
                  "title": "B"
                }
              ]
            }
          }
        ],
        "commands": {
          "add": {
            "actions": [
              {
                "kind": "append",
                "path": ["tasks"],
                "value": {
                  "completed": {"$literal": false},
                  "title": {"$arg": "title"}
                }
              }
            ],
            "arguments": [
              {
                "error": "invalid-title",
                "name": "title",
                "non_empty": true,
                "type": "string"
              }
            ],
            "guards": [
              {
                "error": "duplicate-title",
                "kind": "unique",
                "path": ["tasks"],
                "where": [
                  {
                    "equals": {"$arg": "title"},
                    "field": "title"
                  }
                ]
              }
            ],
            "result": {
              "added": {"$arg": "title"},
              "completed": {"$literal": false}
            }
          },
          "complete": {
            "actions": [
              {
                "kind": "set",
                "target": "open_task",
                "values": {
                  "completed": {"$literal": true}
                }
              }
            ],
            "arguments": [
              {
                "error": "invalid-title",
                "name": "title",
                "non_empty": true,
                "type": "string"
              }
            ],
            "guards": [
              {
                "as": "open_task",
                "error": "task-not-open",
                "kind": "require",
                "path": ["tasks"],
                "where": [
                  {
                    "equals": {"$arg": "title"},
                    "field": "title"
                  },
                  {
                    "equals": {"$literal": false},
                    "field": "completed"
                  }
                ]
              }
            ],
            "result": {
              "completed": {"$arg": "title"}
            }
          },
          "list": {
            "actions": [],
            "arguments": [],
            "guards": [],
            "result": {
              "tasks": {
                "$project": {
                  "fields": ["completed", "title"],
                  "path": ["tasks"]
                }
              }
            }
          }
        },
        "failure_probe": ["list"],
        "kind": "stateful_resource",
        "persistence": {
          "default_path": ".uc-task-ledger.json",
          "environment": "UC_TASK_LEDGER_STATE"
        },
        "rejections": [
          {
            "argv": ["add", ""],
            "exit": 1,
            "expect": {
              "error": "invalid-title",
              "state": "invalid"
            }
          }
        ],
        "state": {
          "expect": {
            "tasks": [
              {
                "completed": true,
                "title": "A"
              },
              {
                "completed": false,
                "title": "B"
              }
            ]
          },
          "initial": {
            "tasks": []
          },
          "schema": [
            {
              "path": ["tasks"],
              "type": "array"
            }
          ]
        }
      }
    }
  ],
  "name": "uc-task-ledger",
  "package": "uc_task_ledger",
  "presentation": {
    "format": "canonical_json",
    "success_from": "result"
  },
  "tests": [],
  "verify": {
    "require_evidence_contains": [
      "boundary:inward",
      "boundary:outward:state.read",
      "part:apply_command",
      "boundary:outward:state.write"
    ],
    "require_value_field": "result"
  }
}
