        "tax_rate": "0.10"
      },
      "expect_stats": {
        "item_count": 1,
        "subtotal": "0.05",
        "tax": "0.01",
        "total": "0.06"
      },
      "kind": "json_document",
      "name": "round_half_up_half_cent"
    },
    {
      "document": {
        "items": [
          {
            "quantity": 2,
            "unit_price": "5.00"
          }
        ],
        "tax_rate": "0"
      },
      "expect_stats": {
        "item_count": 1,
        "subtotal": "10.00",
        "tax": "0.00",
        "total": "10.00"
      },
      "kind": "json_document",
      "name": "zero_tax"
    },
    {
      "document": {
        "items": [
          {
            "quantity": 1,
            "unit_price": "3.00"
          }
        ],
        "tax_rate": "1"
      },
      "expect_stats": {
        "item_count": 1,
        "subtotal": "3.00",
        "tax": "3.00",
        "total": "6.00"
      },
      "kind": "json_document",
      "name": "tax_one"
    },
    {
      "document": {
        "items": [
          {
            "label": "פריט",
            "quantity": 1,
            "unit_price": "1.00"
          }
        ],
        "note": "חשבונית",
        "tax_rate": "0.00"
      },
      "expect_stats": {
        "item_count": 1,
        "subtotal": "1.00",
        "tax": "0.00",
        "total": "1.00"
      },
      "kind": "json_document",
      "name": "unicode_json"
    },
    {
      "document": {
        "items": [
          {
            "quantity": 1,
            "unit_price": "5.00"
          }
        ],
        "tax_rate": "0.20"
      },
      "expect_stats": {
        "item_count": 1,
        "subtotal": "5.00",
        "tax": "1.00",
        "total": "6.00"
      },
      "kind": "json_stdin",
      "name": "stdin_json"
    },
    {
      "argv": [],
      "error": "missing-source",
      "kind": "cli_error",
      "name": "missing_arg"
    },
    {
      "argv": [
        "a",
        "b"
      ],
      "error": "extra-source",
