      "name": "extra_arg"
    },
    {
      "kind": "missing_file",
      "name": "missing_file"
    },
    {
      "kind": "directory",
      "name": "directory"
    },
    {
      "kind": "invalid_utf8",
      "name": "invalid_utf8"
    },
    {
      "error": "invalid-json",
      "kind": "raw_file_error",
